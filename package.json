{
  "name": "@rinci/og",
  "version": "0.2.0",
  "description": "Open Graph cards for RINCI sites: headline and mark layouts, ASCII backgrounds and accents, rendered to a 1200×630 PNG.",
  "license": "MIT",
  "author": "Rafa Al Razzak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rinci-labs/og.git"
  },
  "bin": {
    "rinci-og": "dist/cli.js"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "examples": "bun scripts/examples.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@rinci/brand": "^0.1.0",
    "satori": "^0.60.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.10"
  },
  "packageManager": "bun@1.4.2"
}
